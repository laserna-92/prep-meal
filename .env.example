# Supabase — copy to .env and fill with your project values.
# Exposed to the client, so use the ANON (public) key only — never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# RevenueCat (subscriptions) — fill when wiring monetization.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
